{
    "expo": {
        "name": "programmier.con",
        "slug": "programmier.con",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/images/icon.png",
        "scheme": "myapp",
        "userInterfaceStyle": "automatic",
        "newArchEnabled": true,
        "ios": {
            "supportsTablet": false,
            "bundleIdentifier": "de.programmierbar.conference"
        },
        "android": {
            "package": "de.programmierbar.conference"
        },
        "plugins": ["expo-router", "expo-localization"],
        "experiments": {
            "typedRoutes": true
        }
    }
}
